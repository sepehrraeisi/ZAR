[Unit]
Description=Create and verify a ZAR+ PocketBase backup
Documentation=https://github.com/sepehrraeisi/ZAR/tree/master/docs/stabilization
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=ZAR_BACKUP_LOCK_FILE=/run/zar-backup/lock
ExecStart=/usr/local/sbin/zar-backup
RuntimeDirectory=zar-backup
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/zar/server/pb_data
ReadWritePaths=/backups/zar-daily /run/zar-backup
InaccessiblePaths=/etc/ssh /etc/shadow /etc/gshadow
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=15min
StandardOutput=journal
StandardError=journal
